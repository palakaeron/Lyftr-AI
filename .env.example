# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Comma-separated list of API keys for key-pool failover.
# At least two keys are required to test failover.
LLM_API_KEYS=your_openai_key_1,your_openai_key_2

# ── LLM Model ─────────────────────────────────────────────────────────────────
# LiteLLM model identifier (e.g. gpt-3.5-turbo, gpt-4o, claude-3-haiku-20240307)
LLM_MODEL=gpt-3.5-turbo

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite connection URL. Inside Docker this maps to the persistent volume at /data.
DATABASE_URL=sqlite:////data/app.db

# ── Cache ──────────────────────────────────────────────────────────────────────
# Enable LiteLLM response caching
CACHE_ENABLED=true
# "disk" (persisted in /data/litellm_cache) or "in-memory"
CACHE_TYPE=disk
CACHE_DIR=/data/litellm_cache

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
ALLOWED_ORIGINS=http://localhost:3000

# ── Failure simulation ────────────────────────────────────────────────────────
# Set to true to allow X-Simulate-Failure header on /chat endpoint.
# NEVER set to true in production.
ENABLE_FAILURE_SIMULATION=true

# ── Frontend → Backend URL ────────────────────────────────────────────────────
# Used as the React build-time env var so the frontend knows where the backend is.
REACT_APP_API_URL=http://localhost:8000
